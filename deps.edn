{:paths ["src"]

 ;; VTE is loaded the first time a terminal is made (anchan.vte), so nothing
 ;; is declared under :jolt/native: a machine without VTE can still require
 ;; the library and ask what is missing.

 :aliases {:test {:extra-paths ["test"]}
           :dev {:extra-paths ["dev" "examples"]}
           ;; jolt-metrics' CLI (jolt metrics, metrics:gate), at the commit
           ;; Jonquil and jolt's own CI run
           :metrics {:extra-deps {io.github.jlt-commons/jolt-metrics
                                  {:git/url "https://github.com/jlt-commons/jolt-metrics"
                                   :git/sha "3e13e1f1b86e7ba2db3f28125279864ef7ff0818"}}
                     :main-opts ["-m" "metrics.cli"]}}

 ;; Run as `jolt <task>`; `jolt info` lists them.
 :tasks
 {:requires ([clojure.edn :as edn] [clojure.string :as str]
                                   [babashka.fs :as fs] [babashka.process :as process])
  :init (do
          (def lint-paths ["src" "test" "dev" "examples" "ci"])

          ;; The docs site is rendered by jlt-commons/docs-engine, which lives
          ;; in its own repo; the site:* tasks delegate to it and only preview
          ;; locally. Found via $JLT_DOCS_ENGINE (or $DOCS_ENGINE), then
          ;; ~/dev/jlt-commons/docs-engine, then a sibling checkout.
          (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")
          (defn docs-engine-dir []
            (let [home (System/getProperty "user.home")]
              (->> [(System/getenv "JLT_DOCS_ENGINE")
                    (System/getenv "DOCS_ENGINE")
                    (str home "/dev/jlt-commons/docs-engine")
                    "../docs-engine"]
                   (remove nil?)
                   (filter (fn [d] (fs/exists? (fs/file d "src" "site" "core.clj"))))
                   first)))
          ;; The engine's build and clean run as `jolt run <task>` (bare
          ;; `jolt build` is jolt's own native build). Proxy vars cleared: the
          ;; engine fetches its dependencies on first run.
          (defn site-task [task]
            (if-let [engine (docs-engine-dir)]
              (let [res (process/shell {:dir (str engine) :continue true
                                        :extra-env {"HTTPS_PROXY" "" "https_proxy" ""
                                                    "HTTP_PROXY" "" "http_proxy" ""}}
                                       "jolt" "run" task (str (fs/canonicalize ".")))]
                (when-not (zero? (:exit res)) (System/exit (:exit res))))
              (do (println "The docs engine is not checked out anywhere I looked:")
                  (println "  $JLT_DOCS_ENGINE, $DOCS_ENGINE, ~/dev/jlt-commons/docs-engine, ../docs-engine")
                  (println (str "\n  git clone " docs-engine-repo " ~/dev/jlt-commons/docs-engine"))
                  (System/exit 1))))
          ;; Binding the wildcard address without SO_REUSEADDR is the test, so
          ;; a port held on any interface counts as busy.
          (defn can-bind? [p]
            (let [s (java.net.ServerSocket.)]
              (.setReuseAddress s false)
              (try (.bind s (java.net.InetSocketAddress. (int p)))
                   true
                   (catch Exception _ false)
                   (finally (.close s)))))
          (defn free-port [base span]
            (first (filter can-bind? (range base (inc (+ base span))))))
          ;; Every URL on the site starts with /anchan/, so the static server's
          ;; root holds one link, anchan -> _site, and the pages load as they
          ;; will when published.
          (defn serve-site [port]
            (site-task "build")
            (let [root "target/site-root"]
              (fs/delete-tree root)
              (fs/create-dirs root)
              (fs/create-sym-link (fs/path root "anchan") (fs/canonicalize "_site"))
              (println (str "Serving the docs site at http://localhost:" port "/anchan/ (Ctrl-C stops it)"))
              (shell "python3" "-m" "http.server" (str port) "--bind" "127.0.0.1" "--directory" root)))

          ;; The version a release tag names, and its CHANGELOG.md section.
          (defn changelog-section [version]
            (let [lines (str/split-lines (slurp "CHANGELOG.md"))
                  head? (fn [l] (str/starts-with? l "## "))
                  mine? (fn [l] (re-matches (re-pattern (str "## " (java.util.regex.Pattern/quote version) "( .*)?")) l))
                  body (->> lines (drop-while (complement mine?)) rest (take-while (complement head?)))]
              (when (some mine? lines)
                (str/trim (str/join "\n" body)))))
          (defn release-version []
            (let [v (or (first *command-line-args*)
                        (println "usage: jolt release:notes vX.Y.Z")
                        (System/exit 2))]
              (when-not (re-matches (re-pattern "v\\d+\\.\\d+\\.\\d+") v)
                (println (str "release: " v " isn't a version tag like v0.1.0"))
                (System/exit 2))
              v)))

  info
  {:doc "List the tasks with what each one does"
   :task (let [tasks (:tasks (edn/read-string (slurp "deps.edn")))]
           (println "Anchan tasks (run as: jolt <task>)")
           (doseq [[k v] (sort-by (fn [[k _]] (str k)) tasks)
                   :when (and (symbol? k) (map? v))]
             (println (format "  %-16s %s" k (:doc v "")))))}

  test
  {:doc "Run the unit tests (no display, no VTE needed)"
   :task (shell "jolt" "-A:test" "-m" "anchan.test-runner")}

  selftest
  {:doc "Open a window and drive real terminals through VTE (needs a display and VTE)"
   :task (shell "jolt" "-A:dev" "-m" "anchan-dev.selftest")}

  shell
  {:doc "Run the example: your shell in a window"
   :task (shell "jolt" "-A:dev" "-m" "shell")}

  lint
  {:doc "clj-kondo over src, test, dev, examples and ci (report only)"
   :task (let [{:keys [exit]} (apply shell {:continue true} "clj-kondo" "--lint" lint-paths)]
           (println (if (zero? exit) "OK clj-kondo: no errors or warnings" "-- clj-kondo: see findings above")))}

  lint:strict
  {:doc "lint, but exit non-zero on any finding (2 = warnings, 3 = errors)"
   :task (apply shell "clj-kondo" "--lint" lint-paths)}

  format
  {:doc "Reformat the Clojure files with clojure-lsp (mutating)"
   :task (shell "clojure-lsp" "format")}

  format:check
  {:doc "Check formatting with clojure-lsp (dry run; exits 1 on a diff)"
   :task (shell "clojure-lsp" "format" "--dry")}

  metrics
  {:doc "jolt-metrics report over the repo (Markdown; findings never fail it). Extra args go to metrics.cli: an output file, --top N, --no-git, --exclude GLOB"
   :task (apply shell "jolt" "-M:metrics" "." *command-line-args*)}

  metrics:gate
  {:doc "Fail on a critical jolt-metrics finding under src/, test/, dev/, examples/ or ci/, or on unused code ci/metrics-allow.edn doesn't list"
   :task (do (fs/create-dirs "target")
             (shell "jolt" "-M:metrics" "." "target/metrics-report.edn" "--format" "edn")
             (shell "jolt" "ci/metrics-gate.clj" "target/metrics-report.edn" "ci/metrics-allow.edn"))}

  verify
  {:doc "What CI checks, on this machine: lint:strict, format:check, metrics:gate, test"
   :task (doseq [t ["lint:strict" "format:check" "metrics:gate" "test"]]
           (println (str "== " t))
           (shell "jolt" t))}

  site:build
  {:doc "Build the docs site (docs/guide, docs/site.edn) into _site/ with jlt-commons/docs-engine"
   :task (site-task "build")}

  ;; No port given: scan from 3000 for a free one. A port you name is used
  ;; strictly and refused when busy, never swapped for another.
  site:serve
  {:doc "Build the docs site and serve it at /anchan/; first free port from 3000, or site:serve PORT (refused if busy)"
   :task (let [requested (first *command-line-args*)
               port (when requested (parse-long requested))]
           (when (and requested (not (and port (<= 1 port 65535))))
             (println (str "site:serve: the port is a number from 1 to 65535, not " requested))
             (System/exit 1))
           (if port
             (if (can-bind? port)
               (serve-site port)
               (do (println (str "site:serve: port " port " is busy; pick another, or drop the argument to scan from 3000"))
                   (System/exit 1)))
             (if-let [p (free-port 3000 100)]
               (do (println (str "site:serve: using free port " p))
                   (serve-site p))
               (do (println "site:serve: no free port in 3000..3100")
                   (System/exit 1)))))}

  site:check
  {:doc "Build the docs site, then run docs/check-site.sh against it, as CI does"
   :task (do (site-task "build")
             (shell {:extra-env {"BASE_PATH" "/anchan"}} "bash" "docs/check-site.sh"))}

  site:clean
  {:doc "Delete the _site/ build output"
   :task (site-task "clean")}

  release:notes
  {:doc "Print CHANGELOG.md's section for a version, as the release workflow does: release:notes v0.1.0"
   :task (let [v (release-version)]
           (if-let [notes (changelog-section v)]
             (if (str/blank? notes)
               (do (println (str "release: CHANGELOG.md's " v " section is empty")) (System/exit 1))
               (println notes))
             (do (println (str "release: CHANGELOG.md has no \"## " v "\" section")) (System/exit 1))))}}}
