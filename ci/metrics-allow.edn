;; What ci/metrics-gate.clj (jolt metrics:gate) holds the jolt-metrics report to.
;;
;; :critical-free: path prefixes where a critical finding, or a file
;; jolt-metrics can't read, fails the gate. There's no list of accepted
;; criticals: fix the code. A new top-level source folder takes one edit here,
;; and it must stay out of .jolt-metrics.edn's :test-paths (test paths are
;; never queued, so the prefix alone would gate nothing).
;;
;; :unused-requires, :unused-private, :unused-public: unused code that stays,
;; each {:path :lib-or-:name :why}. The gate fails on unused code missing here,
;; and on an entry here that's no longer reported.
{:critical-free ["src/" "test/" "dev/" "examples/" "ci/"]
 :unused-requires []
 :unused-private []
 :unused-public
 [{:path "src/anchan/core.clj" :name "copy!"
   :why "public API for the program that embeds a terminal; nothing in this repo copies"}
  {:path "src/anchan/core.clj" :name "paste!"
   :why "public API for the program that embeds a terminal; nothing in this repo pastes"}]}
